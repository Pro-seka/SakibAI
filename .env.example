# SakibAI — Environment Variables
# Copy this file to .env and fill in your values
# NOTE: API keys can also be added via the Settings UI — no .env needed for basic use

# OpenAI
OPENAI_API_KEY=sk-...

# Groq (free tier available at console.groq.com)
GROQ_API_KEY=gsk_...

# Together AI (api.together.xyz)
TOGETHER_API_KEY=...

# Ollama runs locally — no key needed
# Just install from ollama.ai and run: ollama serve
